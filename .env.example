# DigitalShield environment template.
# Copy to .env / Workers secrets as needed. NEVER commit real values.

# Public app origin (used for links in emails, CORS same-origin checks)
APP_ORIGIN=http://localhost:5173

# Enforce email verification (1 in production, 0 only for local development)
REQUIRE_EMAIL_VERIFICATION=1

# Development-only escape hatches. MUST stay 0 in production.
# When DEV_MODE=1 AND APP_ORIGIN is localhost, password-reset and
# verification links are included in API responses for local testing.
DEV_MODE=0

# Server-side envelope-encryption master key (32 bytes, base64).
# Generate: openssl rand -base64 32
# Stored as a Workers secret, never in Git.
# ENCRYPTION_MASTER_KEY=

# Session cookie name prefix / lifetime (seconds)
SESSION_TTL_SECONDS=1209600

# Upload limits (bytes / counts)
MAX_UPLOAD_BYTES=26214400
MAX_IMPORT_FILES=200

# Exa web search for Scam Shield (search the public web for reports).
# SERVER-SIDE ONLY: never rename it with a NEXT_PUBLIC_/VITE_ prefix and never
# import exa-js from the SPA. Create and rotate keys at
# https://dashboard.exa.ai/api-keys
# Production: set the secret with wrangler secret put EXA_API_KEY (api/wrangler.toml).
# Local dev: add EXA_API_KEY to .env or api/.dev.vars — both are gitignored.
EXA_API_KEY=
